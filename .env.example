# Copy this file to .env for local use. Never commit the real .env file.
DAVE_CN_CDN=replace-with-cn-cdn-base-url
DAVE_CN_VERSION_CDN=replace-with-cn-version-cdn-base-url
DAVE_CN_RELEASE_PATH=replace-with-cn-release-path
DAVE_API_KEY_HEX=replace-with-aes-key-as-hex
DAVE_API_IV_HEX=replace-with-aes-iv-as-hex
DAVE_APP_HASH=replace-with-current-app-hash
# Optional overrides after a major game update:
# DAVE_APP_VERSION=replace-with-current-app-version
# DAVE_AB_VERSION=replace-with-current-ab-version
